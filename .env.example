# 复制为 .env 后按需修改：cp .env.example .env

# 浏览器访问端口（宿主机侧），容器内固定 8000
# 注意：stock-chart 已占用 8000，这里默认 8001
STOCK_ALERT_PORT=8001

# 时区：影响分时数据时间戳与交易时段判断，不要改成 UTC
TZ=Asia/Shanghai

# 构建上下文：默认当前目录（部署机上的 git 工作副本）
# 若 Docker daemon 能直连 GitHub，可填 Git URL 让 compose 每次自动 clone：
# STOCK_BUILD_CONTEXT=https://github.com/guoymwork/stock-alert.git#main
STOCK_BUILD_CONTEXT="."

# ---- 构建源（只在构建阶段生效，不影响运行时）----
# 默认走官方源；国内网络受限时改成下面这组已验证可用的源
NODE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
NPM_REGISTRY=https://registry.npmmirror.com/
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ---- 运行时代理（可选）----
# 留空表示直连行情接口（推荐）；需要走宿主机代理时填写
# STOCK_HTTP_PROXY=http://host.docker.internal:7897
# STOCK_HTTPS_PROXY=http://host.docker.internal:7897
